{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch mrdario-web-client",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:6868",
            "webRoot": "${workspaceFolder}/web-client/src",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///./*": "${webRoot}/*",
                "webpack:///../../core/src/*": "${workspaceFolder}/core/src/*",
                "webpack:///../../node_modules/*": "${workspaceFolder}/node_modules/*"
            }
        },
        {
            "name": "Attach to mrdario-server",
            "port": 9229,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: start (server)",
            "request": "launch",
            "command": "npm run start",
            "cwd": "${workspaceFolder}/server"
        }
    ]
}
