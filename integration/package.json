{
  "name": "mrdario-integration",
  "version": "1.0.0",
  "description": "Integration tests for Mr. Dario",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test-watch": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "start": "node --loader ts-node/esm src/index.ts"
  },
  "author": "Dan Delany <dan.delany@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@types/jest": "^29.5.14",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "jest": "^29.7.0",
    "mrdario-core": "2.0.0",
    "redis": "^2.8.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {}
}
