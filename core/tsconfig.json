{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "incremental": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": ["jest"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
