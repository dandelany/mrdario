{
  "name": "mrdario-core",
  "version": "2.0.0",
  "description": "Core game code for Mr. Dario",
  "type": "module",
  "main": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./api": {
      "types": "./lib/esm/api/index.d.ts",
      "import": "./lib/esm/api/index.js"
    },
    "./api/auth": {
      "types": "./lib/esm/api/auth/index.d.ts",
      "import": "./lib/esm/api/auth/index.js"
    },
    "./api/auth/*": {
      "types": "./lib/esm/api/auth/*.d.ts",
      "import": "./lib/esm/api/auth/*.js"
    },
    "./api/game": {
      "types": "./lib/esm/api/game/index.d.ts",
      "import": "./lib/esm/api/game/index.js"
    },
    "./api/game/*": {
      "types": "./lib/esm/api/game/*.d.ts",
      "import": "./lib/esm/api/game/*.js"
    },
    "./api/game/encoding": {
      "types": "./lib/esm/api/game/encoding/index.d.ts",
      "import": "./lib/esm/api/game/encoding/index.js"
    },
    "./api/game/encoding/*": {
      "types": "./lib/esm/api/game/encoding/*.d.ts",
      "import": "./lib/esm/api/game/encoding/*.js"
    },
    "./api/lobby": {
      "types": "./lib/esm/api/lobby/index.d.ts",
      "import": "./lib/esm/api/lobby/index.js"
    },
    "./api/lobby/*": {
      "types": "./lib/esm/api/lobby/*.d.ts",
      "import": "./lib/esm/api/lobby/*.js"
    },
    "./api/match": {
      "types": "./lib/esm/api/match/index.d.ts",
      "import": "./lib/esm/api/match/index.js"
    },
    "./api/match/*": {
      "types": "./lib/esm/api/match/*.d.ts",
      "import": "./lib/esm/api/match/*.js"
    },
    "./api/scores": {
      "types": "./lib/esm/api/scores/index.d.ts",
      "import": "./lib/esm/api/scores/index.js"
    },
    "./api/scores/*": {
      "types": "./lib/esm/api/scores/*.d.ts",
      "import": "./lib/esm/api/scores/*.js"
    },
    "./client": {
      "types": "./lib/esm/client/index.d.ts",
      "import": "./lib/esm/client/index.js"
    },
    "./client/*": {
      "types": "./lib/esm/client/*.d.ts",
      "import": "./lib/esm/client/*.js"
    },
    "./game": {
      "types": "./lib/esm/game/index.d.ts",
      "import": "./lib/esm/game/index.js"
    },
    "./game/*": {
      "types": "./lib/esm/game/*.d.ts",
      "import": "./lib/esm/game/*.js"
    },
    "./game/controller": {
      "types": "./lib/esm/game/controller/index.d.ts",
      "import": "./lib/esm/game/controller/index.js"
    },
    "./game/controller/*": {
      "types": "./lib/esm/game/controller/*.d.ts",
      "import": "./lib/esm/game/controller/*.js"
    },
    "./game/input/web": {
      "types": "./lib/esm/game/input/web/index.d.ts",
      "import": "./lib/esm/game/input/web/index.js"
    },
    "./game/input/web/*": {
      "types": "./lib/esm/game/input/web/*.d.ts",
      "import": "./lib/esm/game/input/web/*.js"
    },
    "./game/types": {
      "types": "./lib/esm/game/types/index.d.ts",
      "import": "./lib/esm/game/types/index.js"
    },
    "./game/types/*": {
      "types": "./lib/esm/game/types/*.d.ts",
      "import": "./lib/esm/game/types/*.js"
    },
    "./game/utils": {
      "types": "./lib/esm/game/utils/index.d.ts",
      "import": "./lib/esm/game/utils/index.js"
    },
    "./game/utils/*": {
      "types": "./lib/esm/game/utils/*.d.ts",
      "import": "./lib/esm/game/utils/*.js"
    },
    "./utils/*": {
      "types": "./lib/esm/utils/*.d.ts",
      "import": "./lib/esm/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --coverage",
    "test-watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --watch",
    "clean": "rimraf lib/",
    "build": "npm run clean && tsc -p tsconfig.build.esm.json",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "eslint \"src/**/*.{ts,js}\" --fix",
    "watch-changed": "npm run build && echo 'OK'",
    "watch": "onchange -i 'src/**/*.ts' 'src/**/*.js' -- npm run watch-changed",
    "release": "npm run lint && npm run format && npm run test && npm run clean && npm run build"
  },
  "author": "Dan Delany <dan.delany@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/events": "^3.0.0",
    "@types/hammerjs": "^2.0.36",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/mousetrap": "^1.6.1",
    "@types/seedrandom": "^2.4.27",
    "@types/socketcluster-server": "^20.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^30.0.0",
    "onchange": "~7.1.0",
    "prettier": "2.8.8",
    "rimraf": "^4.4.1",
    "socketcluster-client": "^20.0.1",
    "typescript-eslint": "^8.46.1",
    "ts-jest": "^29.4.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ircam/sync": "^2.1.0",
    "driftless": "^2.0.3",
    "events": "^3.3.0",
    "fp-ts": "^2.16.11",
    "gamepad-plus": "^1.0.14",
    "hammerjs": "^2.0.8",
    "immer": "^10.1.1",
    "io-ts": "^2.2.22",
    "lodash": "^4.17.21",
    "mousetrap": "^1.6.5",
    "seedrandom": "~3.0.5",
    "socketcluster-server": "^20.0.0",
    "typestate": "^1.0.6"
  }
}
