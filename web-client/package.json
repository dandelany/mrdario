{
  "name": "mrdario-client-web",
  "description": "Mr. Dario - a Dr. Mario clone in ES6",
  "author": "Dan Delany <dan.delany@gmail.com>",
  "version": "2.0.0",
  "main": "index.js",
  "repository": "github:dandelany/mrdario",
  "scripts": {
    "build": "npm run clean-build && webpack --config=configs/webpack/prod.js",
    "clean-build": "rm -f -r -d build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/**/*.{js,jsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "start": "npm run start-dev",
    "start-dev": "webpack serve --config=configs/webpack/common.js --host=0.0.0.0 --port 6868",
    "start-prod": "npm run build && cd build && python -m SimpleHTTPServer 6969",
    "test": "jest --config=configs/jest.config.cjs",
    "test:watch": "jest --watch --coverage --config=configs/jest.config.cjs",
    "release": "npm run lint && npm run format && npm run build"
  },
  "dependencies": {
    "@ircam/sync": "^2.1.0",
    "classnames": "^2.2.6",
    "d3-random": "^1.1.2",
    "driftless": "^2.0.3",
    "es6-promisify": "^6.0.1",
    "lodash": "^4.18.1",
    "mrdario-core": "2.0.0",
    "pixi-particles": "^4.3.1",
    "pixi.js": "^4.8.5",
    "rc-slider": "^11.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^7.2.9",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "redux": "^4.0.1",
    "redux-thunk": "^2.3.0",
    "socketcluster-client": "^20.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3-random": "^1.1.1",
    "@types/es6-promisify": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.17.30",
    "@types/pixi.js": "^4.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "css-loader": "^6.10.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "file-loader": "^6.2.0",
    "globals": "^16.4.0",
    "html-webpack-plugin": "^5.6.7",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "less": "^3.9.0",
    "less-loader": "^11.1.4",
    "path-browserify": "^1.0.1",
    "sass": "^1.77.8",
    "sass-loader": "^13.3.3",
    "source-map-loader": "^4.0.2",
    "style-loader": "^3.3.4",
    "svgo": "^4.0.0",
    "svgo-loader": "^4.0.0",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.7",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.1",
    "url": "^0.11.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^5.10.0"
  },
  "license": "MIT"
}
