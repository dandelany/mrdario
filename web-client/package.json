{
  "name": "mrdario-client-web",
  "description": "Mr. Dario - a Dr. Mario clone in ES6",
  "author": "Dan Delany <dan.delany@gmail.com>",
  "version": "2.0.0",
  "main": "index.js",
  "repository": "github:dandelany/mrdario",
  "scripts": {
    "build": "yarn run clean-build && webpack --config=configs/webpack/prod.js",
    "clean-build": "rm -f -r -d build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/**/*.{js,jsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "start": "yarn run start-dev",
    "start-dev": "webpack serve --config=configs/webpack/common.js --host=0.0.0.0 --port 6868",
    "start-prod": "yarn run build && cd build && python -m SimpleHTTPServer 6969",
    "test": "jest --watch --coverage --config=configs/jest.json",
    "release": "yarn run lint && yarn run format && yarn run build"
  },
  "dependencies": {
    "@ircam/sync": "^2.0.0",
    "classnames": "^2.2.6",
    "d3-random": "^1.1.2",
    "driftless": "^2.0.3",
    "es6-promisify": "^6.0.1",
    "lodash": "^4.17.11",
    "mrdario-core": "2.0.0",
    "pixi-filters": "^2.7.0",
    "pixi-particles": "^3.1.0",
    "pixi.js": "^4.8.5",
    "rc-slider": "^8.6.4",
    "react": "^18.3.1",
    "react-container-dimensions": "^1.4.1",
    "react-dom": "^18.3.1",
    "react-redux": "^7.2.9",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "redux": "^4.0.1",
    "redux-thunk": "^2.3.0",
    "socketcluster-client": "^14.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@types/classnames": "^2.3.1",
    "@types/d3-random": "^1.1.1",
    "@types/es6-promisify": "^6.0.0",
    "@types/jest": "^24.0.5",
    "@types/lodash": "^4.14.120",
    "@types/node": "^11.9.4",
    "@types/pixi.js": "^4.8.6",
    "@types/rc-slider": "^8.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-redux": "^7.1.34",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/socketcluster-client": "^13.0.0",
    "css-loader": "^6.10.0",
    "express": "^4.16.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "image-webpack-loader": "^4.6.0",
    "jest": "^26.6.3",
    "less": "^3.9.0",
    "less-loader": "^11.1.4",
    "path-browserify": "^1.0.1",
    "sass": "^1.77.8",
    "sass-loader": "^13.3.3",
    "source-map-loader": "^4.0.2",
    "style-loader": "^3.3.4",
    "svgo-loader": "^2.2.0",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^4.9.5",
    "url": "^0.11.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  },
  "license": "MIT"
}
